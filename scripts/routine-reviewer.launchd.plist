<?xml version="1.0" encoding="UTF-8"?>
<!--
  routine-reviewer.launchd.plist — TEMPLATE for running the ADR-027 routine-reviewer
  UNATTENDED on the Owner's Mac (off-cloud, as @scope-creep-review).

  This is a template. Before loading it (see docs/owner-apply-routine-reviewer.md):
    * replace  __CHECKOUT__  with the absolute path to your scope-creep checkout
        (e.g. /Users/davidmays/code/scope-creep)
    * confirm the review PAT lives at ~/.config/scope-creep/review-pat
    * pick the interval (StartInterval below is 1800s = every 30 min)
  The wrapper reads the PAT into GH_TOKEN at run time, so the token is NOT stored in
  this file. The reviewer itself fails closed (identity + rails + gate #3(ii) checks),
  so a misconfiguration refuses rather than mis-merges.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.scope-creep.routine-reviewer</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>export GH_TOKEN="$(cat "$HOME/.config/scope-creep/review-pat")"; exec "__CHECKOUT__/scripts/routine-reviewer.sh" --unattended</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__CHECKOUT__</string>

    <!-- every 30 minutes; the reviewer is cheap and idempotent (skips anything not cleanly routine+green) -->
    <key>StartInterval</key>
    <integer>1800</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__CHECKOUT__/.routine-reviewer.log</string>
    <key>StandardErrorPath</key>
    <string>__CHECKOUT__/.routine-reviewer.log</string>
</dict>
</plist>
